# pi-astack runtime state (audit logs, checkpoints, search metrics)
.pi-astack/
.abrain-project.json

# Python generated state
__pycache__/
*.pyc

# HarmonyOS, Hvigor, Node.js, and ohpm generated state
**/.hvigor/
**/build/
**/oh_modules/
**/node_modules/
**/.cxx/
**/.idea/
**/.deveco/
**/local.properties
**/*.hap
**/*.app
**/*.hsp
**/*.har

# Generated Go and native probe shared libraries and headers
/spikes/r1-api24-hap/entry/libs/
# G0: the frozen libgoprobe.so IS committed (canonical campaign input, hash
# pre-registered in docs/g0-go-arm64-physical-probe.md; Windows cannot
# reproduce the Linux cgo bytes); every other generated file stays ignored.
/spikes/g0-go-arm64-phys-hap/entry/libs/arm64-v8a/*
!/spikes/g0-go-arm64-phys-hap/entry/libs/arm64-v8a/libgoprobe.so

# N1BDISC: the probe .so IS committed (hash-registered artifact for gate-8
# freeze binding; reproducible via probe/build.sh offline+locked on the
# 26.0.0.821 baseline); every other generated file stays ignored.
/spikes/n1b-disc-phys-hap/entry/libs/arm64-v8a/*
!/spikes/n1b-disc-phys-hap/entry/libs/arm64-v8a/libn1bdisc_probe.so

# N0 native core host build outputs
/spikes/n0-native-core/target/
/spikes/n0-native-core/out/
/spikes/n0-native-core/.hvigor/

# N1a native dataplane host build outputs
/spikes/n1a-native-dataplane/target/
/spikes/n1a-native-dataplane/out/

# Python pytest cache
.pytest_cache/

# Local working directories that must never be committed:
# - artifacts/ holds release-built HAPs (signed/unsigned), device dumps and
#   evidence logs; the release records reference these paths but the binaries
#   and logs are reproduced per release, not versioned.
# - .worktrees/ and .wt/ are the git worktrees for rel/0.0.NN release lines.
# - .upstream-eval/ was the upstream bump research scratch area; its committed
#   reports live in docs/upstream/ and its raw JSON in artifacts/upstream-eval-*.
/artifacts/
/.worktrees/
/.wt/
/.upstream-eval/
/.tmp-*/
/*-build.log
