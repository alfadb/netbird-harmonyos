{
  app: {
    bundleName: 'cn.alfadb.netbird',
    vendor: 'alfadb',
    versionCode: 56,
    versionName: '0.0.56',
    icon: '$media:app_icon',
    label: '$string:app_name',
    // 0.0.46 (I11) 跟随系统字体大小. A HarmonyOS application does NOT follow
    // 设置 → 显示和亮度 → 字体大小 unless this tag points at a profile that says so
    // (OpenHarmony app.json5 reference: the `configuration` tag's initial value is
    // `nonFollowSystem`). The app shipped no such tag, which is why every fp size in
    // pages/Index.ets rendered at 1 fp = 1 vp and read as fixed-size. The profile
    // (resources/base/profile/configuration.json, the modulecheck/configuration.json
    // schema) sets fontSizeScale=followSystem and caps the app at fontSizeMaxScale
    // 1.75 — the ArkUI 适老化 guide's own recommendation.
    configuration: '$profile:configuration'
  }
}
