{
  module: {
    name: 'entry',
    type: 'entry',
    description: '$string:module_description',
    mainElement: 'EntryAbility',
    deviceTypes: [
      'phone',
      '2in1'
    ],
    deliveryWithInstall: true,
    installationFree: false,
    pages: '$profile:main_pages',
    abilities: [
      {
        name: 'EntryAbility',
        srcEntry: './ets/entryability/EntryAbility.ets',
        description: '$string:ability_description',
        icon: '$media:app_icon',
        label: '$string:ability_name',
        startWindowIcon: '$media:app_icon',
        startWindowBackground: '$color:start_window_background',
        exported: true,
        // 2026-10-10 后台保活（0.0.19 实验版，方案 A）：这个 UIAbility 会申请一个
        // DATA_TRANSFER 长时任务（鸿蒙没有 VPN 类型的长时任务，借用「数据传输」是平台
        // 上唯一可用的保活手段；另一款鸿蒙 VPN 客户端也是这么借的）。业务类型与用途不
        // 完全对应，系统可能在判定违规后取消任务，所以这个功能默认由设置页的开关控制，
        // 系统给出的取消/非法判定一律照做（见 NetBirdKeepAlivePolicy）。
        //
        // 2026-10-13（0.0.29）PC 长时任务类型: PC/2in1 上改用 taskKeeping（计算任务，
        // 官方文档原文「对 PC/2in1 设备，应用不需要申请 ACL 权限」）。它没有
        // DATA_TRANSFER 的「超过 10 分钟不更新进度即取消」与「低速取消」两条义务，语义
        // 也更贴近常驻的 VPN 客户端。手机仍用 dataTransfer（taskKeeping 在非 PC 设备上
        // 需要 ohos.permission.KEEP_BACKGROUND_RUNNING_SYSTEM，本应用没有 ACL）。两种
        // 类型都必须在这里声明；具体申请哪一种由 NetBirdKeepAliveService 按
        // deviceInfo.deviceType 在申请时决定（纯函数 keepAliveModeFor 在
        // NetBirdKeepAlivePolicy，宿主自检逐字节验证）。
        backgroundModes: [
          'dataTransfer',
          'taskKeeping'
        ],
        skills: [
          {
            entities: [
              'entity.system.home'
            ],
            actions: [
              'ohos.want.action.home'
            ]
          }
        ]
      }
    ],
    extensionAbilities: [
      {
        name: 'NetBirdVpnExtensionAbility',
        srcEntry: './ets/vpnextensionability/NetBirdVpnExtensionAbility.ets',
        type: 'vpn',
        exported: false
      }
    ],
    requestPermissions: [
      {
        name: 'ohos.permission.INTERNET'
      },
      // N2-H v3.1 C1 dns caliber (preregistration :68, R-4): the shell-side dns
      // freeze set is the PLATFORM DEFAULT (physical) network's resolver list,
      // read with the synchronous @ohos.net.connection APIs getDefaultNetSync /
      // getNetCapabilitiesSync / getConnectionPropertiesSync / getAllNetsSync
      // (physical attribution is proven by NET_CAPABILITY_NOT_VPN being present
      // and BEARER_VPN being absent). All four calls require
      // ohos.permission.GET_NETWORK_INFO.
      // Level/mode: availableLevel normal, grantMode system_grant (since API 8)
      // — the same level and mode as the INTERNET permission above, so this
      // needs no ACL entry in the AGC profile.
      // Without the declaration every call throws BusinessError 201 and the
      // derivation records a dns required-class gap instead of freezing.
      {
        name: 'ohos.permission.GET_NETWORK_INFO'
      },
      // 2026-10-10 后台保活（0.0.19 实验版，方案 A）：DATA_TRANSFER 长时任务
      // （backgroundModes 见上面的 EntryAbility）需要这个权限，官方口径是
      // 「数据传输…等类型的长时任务，仅需使用 ohos.permission.KEEP_BACKGROUND_RUNNING
      // 权限，该权限无需在 AGC 上申请审批」。
      // Level/mode: availableLevel normal, grantMode system_grant —— 与上面的
      // INTERNET / GET_NETWORK_INFO 同级同模式，安装即授予，不需要 ACL 条目，
      // 侧载调试签名即可生效。
      {
        name: 'ohos.permission.KEEP_BACKGROUND_RUNNING'
      },
      // 2026-10-13 关闭到后台（0.0.29）: EntryAbility.onPrepareToTerminate() is the
      // FALLBACK close guard for a device where windowStage.on('windowStageClose')
      // could not be registered (801 on a non-free-window device). The callback
      // vetoes a termination unless this process is running its own explicit quit
      // flow (tray 退出并断开 / 设置 → 退出应用).
      // Level/mode: availableLevel normal, grantMode system_grant, since API 10
      // (@ohos.app.ability.UIAbility.d.ts:672) — granted at install, no ACL entry,
      // and the callback itself executes on 2in1 only.
      {
        name: 'ohos.permission.PREPARE_APP_TERMINATE'
      }
      // MANAGE_VPN is not declared. On the tested device, per-fd
      // VpnConnection.protect(fd) resolves despite MANAGE_VPN check-failure
      // log lines; outer sockets are protected before entering the core.
    ]
  }
}
