{
  module: {
    name: 'entry',
    type: 'entry',
    description: '$string:module_description',
    mainElement: 'EntryAbility',
    deviceTypes: [
      'phone'
    ],
    deliveryWithInstall: true,
    installationFree: false,
    pages: '$profile:main_pages',
    abilities: [
      {
        name: 'EntryAbility',
        srcEntry: './ets/entryability/EntryAbility.ets',
        description: '$string:ability_description',
        icon: '$media:app_icon',
        label: '$string:ability_name',
        startWindowIcon: '$media:app_icon',
        startWindowBackground: '$color:start_window_background',
        exported: true,
        skills: [
          {
            entities: [
              'entity.system.home'
            ],
            actions: [
              'ohos.want.action.home'
            ]
          }
        ]
      }
    ],
    extensionAbilities: [
      {
        name: 'NetBirdVpnExtensionAbility',
        srcEntry: './ets/vpnextensionability/NetBirdVpnExtensionAbility.ets',
        type: 'vpn',
        exported: false
      }
    ],
    requestPermissions: [
      {
        name: 'ohos.permission.INTERNET'
      },
      // N2-H v3.1 C1 dns caliber (preregistration :68, R-4): the shell-side dns
      // freeze set is the PLATFORM DEFAULT (physical) network's resolver list,
      // read with the synchronous @ohos.net.connection APIs getDefaultNetSync /
      // getNetCapabilitiesSync / getConnectionPropertiesSync / getAllNetsSync
      // (physical attribution is proven by NET_CAPABILITY_NOT_VPN being present
      // and BEARER_VPN being absent). All four calls require
      // ohos.permission.GET_NETWORK_INFO.
      // Level/mode: availableLevel normal, grantMode system_grant (since API 8)
      // — the same level and mode as the INTERNET permission above, so this
      // needs no ACL entry in the AGC profile (unlike MANAGE_VPN, see below).
      // Without the declaration every call throws BusinessError 201 and the
      // derivation records a dns required-class gap instead of freezing.
      {
        name: 'ohos.permission.GET_NETWORK_INFO'
      }
      // NOTE (device-verified 2026-09-13/14): per-fd VpnConnection.protect()
      // performs an internal ohos.permission.MANAGE_VPN check, and that
      // permission is a restricted ACL that is NOT appliable in our AGC ACL
      // list. Declaring it here without the profile grant makes the INSTALL
      // fail (code 9568289 "grant request permissions failed"), so it must
      // NOT be declared. The shell therefore uses the public process-level
      // API (protectProcessNet, API 22+, no permission tag) instead — see
      // NetBirdVpnExtensionAbility.protectSocketWithBox.
      // docs/e3-physical-preflight.md:39 already forbids MANAGE_VPN for this
      // project; that constraint now matches platform reality.
    ]
  }
}
