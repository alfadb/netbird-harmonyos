{
  module: {
    name: 'entry',
    type: 'entry',
    description: '$string:module_description',
    mainElement: 'EntryAbility',
    deviceTypes: [
      'phone'
    ],
    deliveryWithInstall: true,
    installationFree: false,
    pages: '$profile:main_pages',
    abilities: [
      {
        name: 'EntryAbility',
        srcEntry: './ets/entryability/EntryAbility.ets',
        description: '$string:ability_description',
        icon: '$media:app_icon',
        label: '$string:ability_name',
        startWindowIcon: '$media:app_icon',
        startWindowBackground: '$color:start_window_background',
        exported: true,
        skills: [
          {
            entities: [
              'entity.system.home'
            ],
            actions: [
              'ohos.want.action.home'
            ]
          }
        ]
      }
    ],
    extensionAbilities: [
      {
        name: 'NetBirdVpnExtensionAbility',
        srcEntry: './ets/vpnextensionability/NetBirdVpnExtensionAbility.ets',
        type: 'vpn',
        exported: false
      }
    ],
    requestPermissions: [
      {
        name: 'ohos.permission.INTERNET'
      },
      {
        // Device-verified 2026-09-13: VpnConnection.protect() performs an
        // ohos.permission.MANAGE_VPN check inside netmanager
        // ("permission check failed, permission:ohos.permission.MANAGE_VPN,
        // callerToken:<app>"); without it the protect promise never settles
        // and every protected-socket gate times out. This is a restricted
        // (ACL) permission: it must ALSO be granted by the signing profile
        // (AGC debug profile -> 申请权限/受控ACL权限), otherwise the install
        // keeps the empty acl list and the check still fails.
        name: 'ohos.permission.MANAGE_VPN'
      }
    ]
  }
}
