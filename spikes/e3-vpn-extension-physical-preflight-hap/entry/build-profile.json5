{
  apiType: 'stageMode',
  buildOption: {
    externalNativeOptions: {
      path: './src/main/cpp/CMakeLists.txt',
      arguments: '-DOHOS_STL=none',
      abiFilters: [
        'arm64-v8a'
      ],
      targets: [
        'fdprobe'
      ]
    }
  },
  targets: [
    {
      name: 'default',
      runtimeOS: 'HarmonyOS',
      config: {
        deviceType: [
          'phone'
        ]
      },
      source: {
        abilities: [
          {
            name: 'EntryAbility',
            label: '$string:ability_name'
          }
        ]
      }
    },
    {
      name: 'vpnB',
      runtimeOS: 'HarmonyOS',
      config: {
        deviceType: [
          'phone'
        ]
      },
      source: {
        abilities: [
          {
            name: 'EntryAbility',
            label: '$string:ability_name_b'
          }
        ]
      }
    }
  ]
}
